{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "Ip": "<db-host>",
    "Port": 5432,
    "User": "<db-user>",
    "Password": "<db-password>",
    "Database": "<db-name>",
    "Pooling": true,
    "MaximumPoolSize": 5,
    "MinimumPoolSize": 0,
    "Timeout": 15
  },
  "APIService": {
    "BaseUrlAccount": "http://localhost:8080"
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
