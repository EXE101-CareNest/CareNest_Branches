{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "Ip": "<db-host>",
    "Port": 5432,
    "User": "<db-user>",
    "Password": "<db-password>",
    "Database": "<db-name>"
  },
  "APIService": {
    "BaseUrlShop": "http://localhost:8080"
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
